# === Discord ===
DISCORD_BOT_TOKEN=your-bot-token-here
OWNER_ID=your-user-id
DISCORD_ALLOWED_USERS=other-allowed-user #leave blank for allow all
# Bot messages: empty = ignore all bots, "all" = accept all, or comma-separated bot IDs
DISCORD_ALLOWED_BOT_IDS=

# === LLM (any OpenAI-compatible endpoint) ===
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=your-local-model-name
# Optional: MODEL_API_KEY=... (leave unset for local servers without auth)

# === Web search (SearXNG with JSON format enabled) ===
SEARXNG_URL=http://localhost:8080

# === Behavior ===
# 1 = require @mention in server channels; 0 = respond to all messages
REQUIRE_MENTION=1

# Session design: shared = one session per channel (whole-chat context,
# [Name] sender labels, unmentioned messages recorded as context)
#                 per_user = one isolated session per user per channel
# Each mode has its own database: data/sessions_shared.db /
# data/sessions_per_user.db. Switch: discordbot session-mode <mode>
# or /session-mode in Discord (restarts the bot to apply).
SESSION_MODE=shared
# How many recent user turns of the channel to include in the model's
# context window. Bigger = the bot remembers more of the conversation
# (this channel's pace fills 30 turns in ~20 min). Local 27B models
# handle 60+ turns fine; keep under ~100 to stay fast.
MAX_HISTORY_MESSAGES=60
MAX_ATTACHMENT_BYTES=25000000
LOG_LEVEL=INFO

# === Outbound media ===
# GIF search (optional): free key from https://developers.giphy.com/ (free tier:
# ~30 req/min, 50k impressions/mo). Without a key the bot can't search GIFs, but can
# still send a direct .gif URL you give it. Stickers use Discord's own API — no key needed.
GIPHY_API_KEY=
# Alternative GIF provider: Klipy (free; 100 req/hr while the key is in testing mode,
# unlimited after production approval) — key from https://partner.klipy.com/.
# With both keys set, the bot tries Giphy first and falls back to Klipy.
KLIPY_API_KEY=
# Which GIF provider search_gifs uses: auto (Giphy then Klipy) | giphy | klipy
GIF_PROVIDER=auto

# === YouTube transcripts (optional) ===
# Proxy for the YouTube caption API, e.g. http://user:pass@host:port. Only needed
# if YouTube persistently blocks your IP — transient rate-limits are retried on their own.
# YOUTUBE_HTTP_PROXY=
