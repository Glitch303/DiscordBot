# === Discord ===
DISCORD_BOT_TOKEN=your-bot-token-here
OWNER_ID=465018176955219969
DISCORD_ALLOWED_USERS=465018176955219969

# === LLM (any OpenAI-compatible endpoint) ===
MODEL_BASE_URL=http://localhost:27906/v1
MODEL_NAME=Qwen3.8-Orca-27B-Instruct
# Optional: MODEL_API_KEY=... (leave unset for local servers without auth)

# === Web search (SearXNG with JSON format enabled) ===
SEARXNG_URL=http://localhost:8080

# === Behavior ===
# 1 = require @mention in server channels; 0 = respond to all messages
REQUIRE_MENTION=1
MAX_HISTORY_MESSAGES=30
MAX_ATTACHMENT_BYTES=25000000
LOG_LEVEL=INFO

# === Outbound media ===
# GIF search (optional): free key from https://developers.giphy.com/ (free tier:
# ~30 req/min, 50k impressions/mo). Without a key the bot can't search GIFs, but can
# still send a direct .gif URL you give it. Stickers use Discord's own API — no key needed.
GIPHY_API_KEY=
# Alternative GIF provider: Klipy (free; 100 req/hr while the key is in testing mode,
# unlimited after production approval) — key from https://partner.klipy.com/.
# With both keys set, the bot tries Giphy first and falls back to Klipy.
KLIPY_API_KEY=
# Which GIF provider search_gifs uses: auto (Giphy then Klipy) | giphy | klipy
GIF_PROVIDER=auto
